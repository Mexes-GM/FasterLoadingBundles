<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>BundleCacheBoost</AssemblyName>
        <RootNamespace>BundleCacheBoost</RootNamespace>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <Version>1.0.0</Version>
        <Authors>Mexes</Authors>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- Reproducible builds without local machine paths embedded in the DLL. -->
        <Deterministic>true</Deterministic>
        <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    </PropertyGroup>

    <!-- SPT 4.0.x install folder. Override with: dotnet build -c Release -p:GameDir="D:\SPT" -->
    <PropertyGroup>
        <GameDir Condition="'$(GameDir)' == ''">..\..</GameDir>
        <Managed>$(GameDir)\EscapeFromTarkov_Data\Managed</Managed>
        <SptPlugins>$(GameDir)\BepInEx\plugins\spt</SptPlugins>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <Reference>
            <Private>False</Private>
        </Reference>
    </ItemDefinitionGroup>

    <ItemGroup>
        <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath></Reference>
        <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath></Reference>
        <Reference Include="Newtonsoft.Json"><HintPath>$(Managed)\Newtonsoft.Json.dll</HintPath></Reference>
        <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath></Reference>
        <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath></Reference>
        <Reference Include="spt-common"><HintPath>$(SptPlugins)\spt-common.dll</HintPath></Reference>
        <Reference Include="spt-custom"><HintPath>$(SptPlugins)\spt-custom.dll</HintPath></Reference>
    </ItemGroup>

    <!-- Release builds produce dist\BundleCacheBoost-<version>.zip, ready to extract into the SPT folder.
         Nothing is copied into BepInEx\plugins automatically. -->
    <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <PropertyGroup>
            <StageDir>$(MSBuildProjectDirectory)\obj\package</StageDir>
            <DistDir>$(MSBuildProjectDirectory)\dist</DistDir>
        </PropertyGroup>
        <RemoveDir Directories="$(StageDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StageDir)\BepInEx\plugins\BundleCacheBoost" />
        <Copy SourceFiles="README.md;LICENSE" DestinationFolder="$(StageDir)\BepInEx\plugins\BundleCacheBoost" />
        <MakeDir Directories="$(DistDir)" />
        <Delete Files="$(DistDir)\BundleCacheBoost-$(Version).zip" />
        <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(DistDir)\BundleCacheBoost-$(Version).zip" />
    </Target>
</Project>
